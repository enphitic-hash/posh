# Copy to .env.local and change if you use your own Supabase project or hosting address.
# Without these, the values in src/config.ts are used.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_YOUR_KEY
# Where the web app is hosted. NFC cards and QR codes are written with links under this address.
VITE_PUBLIC_URL=https://enphitic-hash.github.io/posh/
